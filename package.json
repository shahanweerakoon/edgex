    "build": "node scripts/build.js",
    "lint": "node scripts/lint.js"
  },
  "keywords": [
    "microsoft-edge",
    "edge-extension",
    "manifest-v3",
    "facebook-leads",
    "google-sheets",
    "whatsapp",
    "lead-generation"
