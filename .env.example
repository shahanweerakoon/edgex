# Facebook Lead Collector - Configuration Template
# Copy this file to .env or configure directly in the extension's Settings screen.
#
# IMPORTANT SECURITY NOTICE:
# - Microsoft Edge Extensions run in the user's browser client-side.
# - NEVER store a Google OAuth client secret or Google service account private key here.
# - Only the public OAuth 2.0 Client ID is needed for the browser WebAuthFlow.

# Google Cloud OAuth 2.0 Client ID (Web Application or Chrome App type)
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Target Google Spreadsheet ID or URL (Optional default - can be selected in Settings UI)
# The ID is the long string in the sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Default Business Category for new leads (Optional, e.g. General, Software, Retail)
DEFAULT_CATEGORY=General
